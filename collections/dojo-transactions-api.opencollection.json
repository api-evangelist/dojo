{
  "opencollection": "1.0.0",
  "info": {
    "name": "Transaction API",
    "version": "2023-11-12"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all transactions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dojo.tech/transactions/search",
            "headers": [
              {
                "name": "version",
                "value": "2022-04-07"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves a list of transactions.\nResults are paginated. By default, the method returns up to 50 transactions."
        }
      ]
    }
  ],
  "bundled": true
}