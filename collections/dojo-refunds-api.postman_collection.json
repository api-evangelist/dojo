              "item": [
                {
                  "name": "Create a refund",
                  "id": "942e8c21-fbda-4c4e-9217-6f12e18b21ae",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "description": "(Required) The API version with format yyyy-mm-dd. The current version is `2026-02-27`.",
                        "key": "version",
                        "value": "<date>"
                      },
                      {
                        "description": "(Required) An idempotency key is used to recognize subsequent retries of the same request. How you generate the idempotency key is up to you. The key must be unique for each new refund processed on the payment intent.\n",
                        "key": "idempotencyKey",
                        "value": "<string,null>"
                      },
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"amount\": \"<long>\",\n  \"previousTransactionId\": \"<string,null>\",\n  \"refundReason\": \"<string,null>\",\n  \"notes\": \"<string,null>\"\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/payment-intents/:paymentIntentId/refunds",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
